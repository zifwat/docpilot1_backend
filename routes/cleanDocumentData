
function cleanDocumentData(document) {
    const cleanedData = {};

    function cleanFields(fields, parentKey = '') {
        for (const [fieldName, field] of Object.entries(fields)) {
            let currentKey = `${parentKey}${fieldName}`;

            // Handle fields that are arrays
            if (field.kind === 'array' && Array.isArray(field.values)) {
                field.values.forEach((element, index) => {
                    // Check if the element is an object or has properties
                    if (element.properties && typeof element.properties === 'object') {
                        // Recursively clean nested properties
                        cleanFields(element.properties, `${currentKey}_${index}_`);
                    } else {
                        // Handle primitive values in the array
                        handleValue(element.value, `${currentKey}_${index}`);

                        // Handle bounding regions if present for each element
                        if (element.boundingRegions) {
                            cleanedData[`${currentKey}_${index}_boundingRegions`] = element.boundingRegions.map(region => ({
                                pageNumber: region.pageNumber || null,
                                polygon: region.polygon ? region.polygon.map(point => ({
                                    x: point.x,
                                    y: point.y
                                })) : null
                            }));
                        }
                    }
                });
            } 
            // Handle fields that are objects (nested structure)
            else if (field.kind === 'object' || field.properties) {
                if (field.properties) {
                    // Recursively clean nested properties
                    cleanFields(field.properties, `${currentKey}_`);
                } else {
                    // Handle if it's a primitive object
                    handleValue(field.value, currentKey);
                }
            }
            // Handle primitive values directly
            else if (field.value) {
                handleValue(field.value, currentKey);
            }

            // Handle bounding regions if present for each field
            if (field.boundingRegions) {
                cleanedData[`${currentKey}_boundingRegions`] = field.boundingRegions.map(region => ({
                    pageNumber: region.pageNumber || null,
                    polygon: region.polygon ? region.polygon.map(point => ({
                        x: point.x,
                        y: point.y
                    })) : null
                }));
            }
        }
    }

    // Function to handle values and flatten nested objects or arrays within them
    function handleValue(value, parentKey) {
        if (Array.isArray(value)) {
            value.forEach((element, index) => {
                handleValue(element, `${parentKey}_${index}`);
            });
        } else if (typeof value === 'object' && value !== null) {
            flattenNestedObject(value, parentKey);
        } else {
            cleanedData[`${parentKey}_value`] = value;
        }
    }

    // Function to flatten nested object structures
    function flattenNestedObject(nestedObject, parentKey) {
        for (const [nestedKey, nestedValue] of Object.entries(nestedObject)) {
            if (Array.isArray(nestedValue)) {
                // If it's an array, handle each element
                nestedValue.forEach((element, index) => {
                    handleValue(element, `${parentKey}_${nestedKey}_${index}`);
                });
            } else if (typeof nestedValue === 'object' && nestedValue !== null) {
                // If it's a nested object, call this function recursively
                flattenNestedObject(nestedValue, `${parentKey}_${nestedKey}`);
            } else {
                // Handle normal values
                cleanedData[`${parentKey}_${nestedKey}_value`] = nestedValue;
            }
        }
    }

    // Start cleaning process from the top-level fields
    if (document.fields) {
        cleanFields(document.fields);
    }

    return cleanedData;
}


module.exports = cleanDocumentData;
